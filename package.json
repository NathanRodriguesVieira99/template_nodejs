{
  "author": "@NathanRodriguesVieira99",
  "name": "template_nodejs",
  "version": "0.4.4",
  "main": "main.ts",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "24.21.0"
  },
  "scripts": {
    "build": "tsup --tsconfig tsconfig.build.json src/main.ts --format esm",
    "docker:up": "docker compose up -d",
    "docker:stop": "docker compose stop",
    "docker:restart": "docker compose restart",
    "docker:down": "docker compose down",
    "start:dev": "tsx watch --env-file=.env.dev src/main.ts",
    "start:prod": "node --env-file=.env dist/main.js",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest --watch",
    "test:cov": "vitest run --coverage",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/sinon": "^22.0.0",
    "@vitest/coverage-v8": "5.0.3",
    "axios": "^1.20.0",
    "husky": "^9.1.7",
    "knex": "^3.3.0",
    "nock": "^14.0.17",
    "oxlint": "^1.89.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "sinon": "^22.1.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/otel": "^0.21.3",
    "@opentelemetry/auto-instrumentations-node": "^0.81.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.223.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/host-metrics": "^0.39.0",
    "@opentelemetry/instrumentation-http": "^0.223.0",
    "@opentelemetry/instrumentation-kafkajs": "^0.32.0",
    "@opentelemetry/instrumentation-pg": "^0.75.0",
    "@opentelemetry/instrumentation-pino": "^0.69.0",
    "@opentelemetry/resources": "^3.0.0",
    "@opentelemetry/sdk-metrics": "^2.12.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@ousiaresearch/kafkajs": "3.2.0-beta.0",
    "fastify": "^5.12.5",
    "pg": "^8.23.1",
    "pg-promise": "^12.7.1",
    "pino": "^10.4.0",
    "pino-loki": "^3.0.0"
  }
}
